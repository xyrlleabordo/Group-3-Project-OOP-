public static void checkCoinReward() {
    long currentTime = System.currentTimeMillis();

    if (currentTime - lastRewardTime >= 30 * 1000) {

        long timePassed = (currentTime - lastRewardTime) / (30 * 1000);

        for (int i = 0; i < timePassed; i++) {

            int playerReward = COIN_REWARDS[random.nextInt(COIN_REWARDS.length)];
            int enemyReward = COIN_REWARDS[random.nextInt(COIN_REWARDS.length)];

            coins += playerReward;
            enemyCoins += enemyReward;

            System.out.println("\n--------------------------{Gold Reward}---");
            System.out.println(">> You received " + playerReward + " coins!");
            System.out.println(">> Total Coins: " + coins);

            System.out.println(">> Opponent received " + enemyReward + " coins!");
            System.out.println(">> Enemy Coins: " + enemyCoins);
        }
        lastRewardTime += timePassed * (30 * 1000);
    }
  }
